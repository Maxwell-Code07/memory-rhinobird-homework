# ============================================
# Hermes Soak Test 环境变量配置（对齐参考 openclaw-soak-tool/.env.example）
# 用法: cp .env.example .env 然后修改
# 命令行参数优先级高于 .env
# ============================================

# [选填] 目标对话轮次，默认 10
# SOAK_ROUNDS=30

# [选填] 对话间隔（毫秒），默认 5000
# SOAK_INTERVAL_MS=6000

# [选填] 测试总时长（秒），默认 0 = 不限
# SOAK_DURATION_SEC=600

# [选填] 单轮超时（毫秒），默认 180000
# SOAK_TIMEOUT_MS=180000

# [选填] hermes 可执行文件，默认 hermes
# SOAK_HERMES=hermes

# [选填] 会话模式: new（每轮新会话）/ same（首轮后 --resume 同一 session）
# SOAK_SESSION_MODE=new

# [选填] 记忆探针: 每 N 轮一组（第 N/2 轮植入、第 N 轮回忆核对），0=关闭
# SOAK_PROBE_EVERY=8

# [选填] 日志监控（逗号分隔，增量收集 error/warn/memory-tdai 事件）
# SOAK_LOG_FILES=/opt/data/logs/agent.log,/opt/data/logs/errors.log

# [选填] 资源监控采样间隔（毫秒），0=关闭，默认 10000
# SOAK_RESOURCE_INTERVAL_MS=5000

# [选填] 结果输出目录，默认 out-<时间戳>
# SOAK_OUTPUT_DIR=./out-run
