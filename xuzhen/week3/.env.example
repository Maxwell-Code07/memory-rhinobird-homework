# Copy this file to .env and fill in a real OpenAI-compatible key locally.
# Do not commit .env or paste real keys into screenshots/logs.
OPENAI_API_KEY=
# For a DeepSeek endpoint, set this to the same value as OPENAI_API_KEY.
DEEPSEEK_API_KEY=
TDAI_LLM_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
HERMES_INFERENCE_PROVIDER=deepseek
HERMES_INFERENCE_MODEL=deepseek-v4-flash
TDAI_LLM_BASE_URL=https://api.openai.com/v1
TDAI_LLM_MODEL=gpt-4o
MEMORY_TENCENTDB_GATEWAY_HOST=127.0.0.1
MEMORY_TENCENTDB_GATEWAY_PORT=8420
TDAI_DATA_DIR=/opt/hermes-home/memory-data
HERMES_HOME=/opt/hermes-home
MEMORY_TENCENTDB_ROOT=/opt/hermes-home/.memory-tencentdb
