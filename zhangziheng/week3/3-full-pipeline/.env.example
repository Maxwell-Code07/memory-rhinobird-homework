# Copy this file to .env, fill it locally, and never commit .env.
# One supported style: an OpenAI-compatible endpoint, e.g.
#   https://api.minimax.cn/v1   https://api.deepseek.com/v1   https://api.openai.com/v1

# 1) Required: your secret model API key.
HERMES_API_KEY=
# 2) Required: OpenAI-compatible base URL, including the /v1 suffix.
HERMES_BASE_URL=
# 3) Required: exact model ID/name exposed by the service.
HERMES_MODEL=
# 4) Optional: Hermes version; otherwise pass x.y.z on the command line.
HERMES_VERSION=

# Optional: pin the API style. Only "openai" is accepted; leave empty to default to it.
HERMES_API_STYLE=

# Optional: thinking-suppression strategy for the memory plugin's L1-L3 extraction LLM.
# Leave empty to auto-detect from HERMES_BASE_URL host:
#   minimax*  -> anthropic    deepseek* -> deepseek     dashscope|aliyun -> dashscope
#   anthropic*-> anthropic    google*   -> gemini       openai.com|openrouter -> openai
#   anything else -> false (inject nothing; safest for unknown/self-hosted endpoints)
# Accepted values: false | vllm | deepseek | dashscope | openai | anthropic | kimi | gemini
TDAI_LLM_DISABLE_THINKING=

# Advanced optional override. Normally inferred as OPENAI_API_KEY.
# HERMES_PROVIDER_API_KEY_ENV=
