# 命令行参数优先于这里的配置。不要把真实 API Key 提交到仓库。
SOAK_ROUNDS=20
SOAK_INTERVAL_MS=1000
SOAK_DURATION_MINUTES=30
SOAK_REQUEST_TIMEOUT_MS=120000

# 可选：自定义结果目录、剧本、Hermes 会话和模型。
# SOAK_OUTPUT_DIR=./workspace/my-run
# SOAK_PROMPTS_FILE=./prompts.example.json
# 可选：从一个已有的 Hermes session ID 开始续接。
# SOAK_SESSION=20260908_123456_abcd12
# SOAK_MODEL=openrouter/anthropic/claude-sonnet-4
# SOAK_PROVIDER=openrouter
# 基础 soak 只测试对话，默认使用 Hermes 的空工具集，避免初始化无关工具。
SOAK_TOOLSETS=context_engine
# SOAK_HERMES_COMMAND=hermes
