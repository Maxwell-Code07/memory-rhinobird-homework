# Hermes model service used by the soak conversation.
HERMES_SOAK_BASE_URL=https://example.invalid/v1
HERMES_SOAK_MODEL=replace-with-model-name
HERMES_SOAK_API_KEY=replace-with-api-key

# Optional: use a separate model service for L1-L3 extraction.
# TDAI_LLM_BASE_URL=https://example.invalid/v1
# TDAI_LLM_MODEL=replace-with-model-name
# TDAI_LLM_API_KEY=replace-with-api-key

HERMES_VERSION=0.20.6
MEMORY_GATEWAY_PORT=8473
SOAK_ROUNDS=6
SOAK_INTERVAL=1s
SOAK_DURATION=15m
MEMORY_PACKAGE_SPEC=@tencentdb-agent-memory/memory-tencentdb@1.0.1
