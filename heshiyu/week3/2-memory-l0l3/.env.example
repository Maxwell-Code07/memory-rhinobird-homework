HERMES_SOAK_BASE_URL=https://example.invalid/v1
HERMES_SOAK_MODEL=replace-with-model-name
HERMES_SOAK_API_KEY=replace-with-api-key

# Memory extraction can reuse the same service or use separate values.
TDAI_LLM_BASE_URL=https://example.invalid/v1
TDAI_LLM_MODEL=replace-with-model-name
TDAI_LLM_API_KEY=replace-with-api-key

TDAI_DATA_DIR=/opt/data/.memory-tencentdb/memory-tdai
MEMORY_GATEWAY_URL=http://127.0.0.1:8420
HERMES_EXPECTED_VERSION=0.20.6
SOAK_ROUNDS=6
SOAK_INTERVAL=1s
SOAK_DURATION=15m
SOAK_ROUND_TIMEOUT=180s
SOAK_ROUND_RETRIES=2
SOAK_PROBE_WAIT=300s
SOAK_PROBE_POLL=3s
MEMORY_VERIFY_WAIT=240s
MEMORY_VERIFY_POLL=3s
