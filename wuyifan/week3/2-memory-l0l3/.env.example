# 构建与容器名称
HERMES_VERSION=0.19.0
CONTAINER_NAME=hermes-week3-memory
MEMORY_PLUGIN_VERSION=latest

# Hermes 推理模型：填写你的 OpenAI 兼容中转站信息。
# 不要把填写后的 .env 提交到 Git。
HERMES_API_KEY=
HERMES_BASE_URL=https://your-relay.example/v1
HERMES_MODEL=deepseek-chat

# Gateway 的 L1-L3 生成模型，可以与 Hermes 使用同一中转站和模型。
TDAI_LLM_API_KEY=
TDAI_LLM_BASE_URL=https://your-relay.example/v1
TDAI_LLM_MODEL=deepseek-chat
TDAI_DATA_DIR=/home/hermes/.memory-tencentdb/memory-tdai
TDAI_GATEWAY_CONFIG=/home/hermes/.memory-tencentdb/tdai-gateway.json
MEMORY_TENCENTDB_GATEWAY_HOST=127.0.0.1
MEMORY_TENCENTDB_GATEWAY_PORT=8420

# Soak 参数
HERMES_COMMAND=hermes

# soak 默认参数；传给 run-soak.sh 的命令行参数优先级更高。
SOAK_ROUNDS=10
SOAK_INTERVAL_MS=1000
SOAK_DURATION_SECONDS=300
SOAK_TIMEOUT_SECONDS=120
SOAK_MAX_CONSECUTIVE_FAILURES=3
SOAK_PROMPTS=./memory-prompts.json

# 留空时，hermes-soak.mjs 自动创建带时间戳的结果目录。
SOAK_OUTPUT=
